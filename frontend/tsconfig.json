{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "jsx": "react-jsx",
    "jsxImportSource": "@mizhuo/i18n",
    "paths": { "@mizhuo/i18n/*": ["./src/i18n/*"] },
    "types": ["vite/client", "node"]
  },
  "include": ["src", "vite.config.ts", "tests"]
}
