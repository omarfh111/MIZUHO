# Copy to .env and fill in. .env is git-ignored: never commit a real key.
# Any OpenAI-compatible chat completions endpoint works.

# NVIDIA API catalog (build.nvidia.com)
LLM_BASE_URL=https://integrate.api.nvidia.com/v1
LLM_API_KEY=
LLM_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b

# Other models on the same endpoint, for example:
#   nvidia/nemotron-3.5-bolt-e4b              (smaller, faster)
#   nvidia/nemotron-3.5-super-vl-120b-a12b    (larger)

# Generation settings
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=900
LLM_TIMEOUT_S=60
# Nemotron 3.5 models reason before answering and can use all tokens doing so.
# true sends chat_template_kwargs.enable_thinking=false; set false for endpoints that reject it.
LLM_DISABLE_THINKING=true

# TypeSafe Jev decision model (Judge agent of the cause funnel): typed answers with probabilities.
# Key from console.typesafe.ai/keys. Without it, the funnel ranks causes on the data alone.
TYPESAFE_API_KEY=
TYPESAFE_MODEL=jev-latest
TYPESAFE_TIMEOUT_S=30

# Qdrant for the assistant's document search. Leave QDRANT_URL empty to use a local
# embedded Qdrant in data/rag/qdrant_local/ (one process at a time).
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION=mizu_m1_docs

# Embeddings (default: NVIDIA endpoint and LLM_API_KEY)
EMBED_MODEL=nvidia/nemotron-3-embed-1b
# EMBED_BASE_URL=
# EMBED_API_KEY=
